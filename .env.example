# Telegram API credentials from https://my.telegram.org/auth
TELETHON_API_ID=123456
TELETHON_API_HASH=your_api_hash_here

# Session file path/name (default: telethon_data/telethon)
# TELETHON_SESSION=telethon_data/telethon

# Database URL (default: SQLite in telethon_data/messages.db)
# For PostgreSQL via docker-compose: postgresql+asyncpg://messengers:messengers@localhost:5433/messengers_analyze
# DATABASE_URL=sqlite+aiosqlite:///telethon_data/messages.db
DATABASE_URL=postgresql+asyncpg://messengers:messengers@localhost:5433/messengers_analyze

# PostgreSQL credentials used by docker-compose.yml
POSTGRES_USER=messengers
POSTGRES_PASSWORD=messengers
POSTGRES_DB=messengers_analyze
POSTGRES_PORT=5433

# Comma-separated list of allowed informational chat ids/usernames/titles.
# Only messages from these chats will be stored.
# If left empty, messages from ALL chats will be collected.
ALLOWED_INFO_CHATS=example_channel,another_channel

# Logging level
LOG_LEVEL=INFO
